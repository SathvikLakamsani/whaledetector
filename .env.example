# Required for Discord alerts (leave empty to run without sending)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
DISCORD_WEBHOOK_USERNAME=Polymarket Whale Alerts
DISCORD_WEBHOOK_AVATAR_URL=

# SQLite path (relative to cwd or absolute)
DATABASE_PATH=./polymarket_whale_alerts.db

# Whale & merge
MIN_WHALE_USD=15000
MERGE_WINDOW_SECONDS=45

# Market eligibility (gamma + data-api heuristics)
MARKET_MIN_AGE_HOURS=24
MARKET_MIN_LIQUIDITY_USD=25000
MARKET_MIN_RECENT_VOLUME_USD=50000
# Minimum number of locally stored fills before relativity uses full percentile logic
MARKET_MIN_RECENT_FILLS=50
MARKET_SYNC_INTERVAL_SECONDS=300
MARKET_PAGE_LIMIT=150
MARKET_MAX_PAGES=20
MAX_SUBSCRIBED_ASSETS=400

# Relativity: look back this many days of stored fills for percentile / ratios
RELATIVITY_LOOKBACK_DAYS=7

# Scoring weights (must sum to 1.0 ideally; normalized if not)
SCORING_WEIGHT_RELATIVITY=0.55
SCORING_WEIGHT_AMOUNT=0.30
SCORING_WEIGHT_SUCCESS=0.15

# Amount score: log-scale reference notionals (USD)
AMOUNT_SCORE_REF_MIN_USD=10000
AMOUNT_SCORE_REF_MAX_USD=500000

# Severity cutoffs on composite score [0,1]
SEVERITY_VERY_LARGE_MIN_SCORE=0.62
SEVERITY_EXTREME_MIN_SCORE=0.82

# Wallet stats cache
WALLET_STATS_CACHE_MINUTES=15
CLOSED_POSITIONS_PAGE_LIMIT=50

# WebSocket
WS_PING_INTERVAL_SECONDS=10
WS_RECONNECT_MAX_SECONDS=120
WS_TRADES_BATCH_SIZE=80
TRADES_POLL_INTERVAL_SECONDS=2
TRADES_POLL_LIMIT=500
MAX_POLLED_TRADE_AGE_SECONDS=3600

# HTTP
HTTP_TIMEOUT_SECONDS=30
DATA_API_BASE_URL=https://data-api.polymarket.com
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

# Logging
LOG_LEVEL=INFO
